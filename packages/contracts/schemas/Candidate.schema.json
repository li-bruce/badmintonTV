{
  "$defs": {
    "Evidence": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Typed source intervals plus open evidence metadata (PTS, method, score).",
      "properties": {
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        }
      },
      "required": [
        "type"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "start_ms": {
      "minimum": 0,
      "title": "Start Ms",
      "type": "integer"
    },
    "end_ms": {
      "minimum": 0,
      "title": "End Ms",
      "type": "integer"
    },
    "player_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Player Id"
    },
    "event_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Event Ids",
      "type": "array"
    },
    "matched_conditions": {
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          }
        ]
      },
      "title": "Matched Conditions",
      "type": "array"
    },
    "missing_conditions": {
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          }
        ]
      },
      "title": "Missing Conditions",
      "type": "array"
    },
    "uncertainty_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainty Reasons",
      "type": "array"
    },
    "rank_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rank Score"
    },
    "review_status": {
      "default": "unreviewed",
      "enum": [
        "unreviewed",
        "confirmed",
        "rejected"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "reviewer_type": {
      "anyOf": [
        {
          "enum": [
            "human",
            "agent"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer Type"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "asset_id",
    "start_ms",
    "end_ms"
  ],
  "title": "Candidate",
  "type": "object"
}
