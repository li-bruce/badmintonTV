{
  "$defs": {
    "JsonValue": {},
    "Weight": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "license_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Url"
        }
      },
      "required": [
        "relative_path",
        "sha256"
      ],
      "title": "Weight",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "status": {
      "enum": [
        "not_installed",
        "ready",
        "experimental",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "entrypoint": {
      "anyOf": [
        {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entrypoint"
    },
    "environment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment"
    },
    "weights": {
      "items": {
        "$ref": "#/$defs/Weight"
      },
      "title": "Weights",
      "type": "array"
    },
    "parameters_schema": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Parameters Schema",
      "type": "object"
    },
    "input_schema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Schema"
    },
    "output_schema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Schema"
    },
    "supported_labels": {
      "anyOf": [
        {
          "additionalProperties": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      ],
      "title": "Supported Labels"
    },
    "supported_camera_types": {
      "items": {
        "enum": [
          "rear",
          "side",
          "overhead",
          "handheld",
          "mixed",
          "unknown"
        ],
        "type": "string"
      },
      "title": "Supported Camera Types",
      "type": "array"
    },
    "evaluation_report": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Report"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "resource_requirements": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Resource Requirements",
      "type": "object"
    }
  },
  "required": [
    "model_id",
    "version",
    "display_name",
    "status"
  ],
  "title": "ModelManifest",
  "type": "object"
}
