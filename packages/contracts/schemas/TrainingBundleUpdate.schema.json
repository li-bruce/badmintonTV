{
  "$defs": {
    "JsonValue": {},
    "TrainingActorState": {
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Person Id"
        },
        "team_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Id"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrainingPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "movement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Movement"
        },
        "missing_reasons": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Reasons",
          "type": "array"
        }
      },
      "title": "TrainingActorState",
      "type": "object"
    },
    "TrainingAnnotationBundle": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "format": {
          "const": "badmintontv.training.annotations.v1",
          "default": "badmintontv.training.annotations.v1",
          "title": "Format",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "asset": {
          "$ref": "#/$defs/TrainingAssetRef"
        },
        "revision": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "people": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TrainingPerson"
          },
          "title": "People",
          "type": "array"
        },
        "records": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TrainingRecord"
          },
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "asset"
      ],
      "title": "TrainingAnnotationBundle",
      "type": "object"
    },
    "TrainingAssetRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "usage_scope": {
          "const": "training_only",
          "default": "training_only",
          "title": "Usage Scope",
          "type": "string"
        },
        "source_usage_scope": {
          "default": "training_only",
          "enum": [
            "general",
            "training_only"
          ],
          "title": "Source Usage Scope",
          "type": "string"
        },
        "match_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Id"
        },
        "group_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "group_status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "unconfirmed",
            "confirmed"
          ],
          "title": "Group Status",
          "type": "string"
        },
        "root_asset_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Root Asset Ids",
          "type": "array"
        },
        "source_sha256s": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-fA-F]{64}$",
            "type": "string"
          },
          "title": "Source Sha256S",
          "type": "array"
        },
        "recording_session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recording Session Id"
        },
        "source_group_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Group Ids",
          "type": "array"
        },
        "pts_reference": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pts Reference"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provenance",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "relative_path",
        "size_bytes",
        "duration_ms"
      ],
      "title": "TrainingAssetRef",
      "type": "object"
    },
    "TrainingJudgement": {
      "additionalProperties": false,
      "properties": {
        "label_id": {
          "minLength": 1,
          "title": "Label Id",
          "type": "string"
        },
        "subject_role": {
          "default": "self",
          "enum": [
            "self",
            "opponent",
            "partner",
            "opponent_partner"
          ],
          "title": "Subject Role",
          "type": "string"
        },
        "subject_person_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Person Id"
        },
        "value": {
          "enum": [
            "present",
            "absent",
            "unknown",
            "not_applicable",
            "unlabeled",
            "unobservable"
          ],
          "title": "Value",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "source_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Label"
        },
        "mapping_status": {
          "default": "manual",
          "enum": [
            "manual",
            "exact",
            "coarse",
            "unverified"
          ],
          "title": "Mapping Status",
          "type": "string"
        }
      },
      "required": [
        "label_id",
        "value"
      ],
      "title": "TrainingJudgement",
      "type": "object"
    },
    "TrainingPerson": {
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "minLength": 1,
          "title": "Person Id",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "team_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Id"
        },
        "identity_status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "unconfirmed",
            "confirmed"
          ],
          "title": "Identity Status",
          "type": "string"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provenance",
          "type": "object"
        }
      },
      "required": [
        "person_id",
        "display_name"
      ],
      "title": "TrainingPerson",
      "type": "object"
    },
    "TrainingPosition": {
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "enum": [
            "image_normalized",
            "court_m"
          ],
          "title": "Coordinate System",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "calibration_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Id"
        },
        "source": {
          "default": "agent",
          "enum": [
            "human",
            "agent",
            "model",
            "import"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "coordinate_system",
        "x",
        "y"
      ],
      "title": "TrainingPosition",
      "type": "object"
    },
    "TrainingRecord": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "rally",
            "contact",
            "dead_ball",
            "segment",
            "state"
          ],
          "title": "Kind",
          "type": "string"
        },
        "at_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At Ms"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "uncertainty_start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Start Ms"
        },
        "uncertainty_end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty End Ms"
        },
        "person_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Person Id"
        },
        "team_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Id"
        },
        "rally_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rally Id"
        },
        "dead_ball_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dead Ball Id"
        },
        "segment_type": {
          "anyOf": [
            {
              "enum": [
                "stroke",
                "footwork",
                "tactic",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Type"
        },
        "judgements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TrainingJudgement"
          },
          "title": "Judgements",
          "type": "array"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrainingState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visibility": {
          "default": "unknown",
          "enum": [
            "clear",
            "partial",
            "unobservable",
            "unknown"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "unknown_reasons": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unknown Reasons",
          "type": "array"
        },
        "raw_labels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Raw Labels",
          "type": "array"
        },
        "evidence": {
          "default": [],
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Evidence",
          "type": "array"
        },
        "review": {
          "$ref": "#/$defs/TrainingReview"
        },
        "revision": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "previous_revision": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Revision"
        },
        "deleted": {
          "default": false,
          "title": "Deleted",
          "type": "boolean"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provenance",
          "type": "object"
        }
      },
      "required": [
        "record_id",
        "project_id",
        "asset_id",
        "kind"
      ],
      "title": "TrainingRecord",
      "type": "object"
    },
    "TrainingReview": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "pending",
            "confirmed",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewer_type": {
          "anyOf": [
            {
              "enum": [
                "human",
                "agent",
                "model",
                "import"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Type"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "title": "TrainingReview",
      "type": "object"
    },
    "TrainingState": {
      "additionalProperties": false,
      "properties": {
        "self": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrainingActorState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "opponent": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrainingActorState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "partner": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrainingActorState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "opponent_partner": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrainingActorState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "incoming_ball": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incoming Ball"
        },
        "outgoing_ball": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outgoing Ball"
        },
        "missing_reasons": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Reasons",
          "type": "array"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provenance",
          "type": "object"
        }
      },
      "title": "TrainingState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bundle": {
      "$ref": "#/$defs/TrainingAnnotationBundle"
    },
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    }
  },
  "required": [
    "bundle",
    "expected_revision"
  ],
  "title": "TrainingBundleUpdate",
  "type": "object"
}
